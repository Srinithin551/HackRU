# Copy to .env (repo root) and fill in. Never commit .env.

GEMINI_API_KEY=
# Main model: plans the questions and writes the report.
GEMINI_MODEL=gemini-3.6-flash
# Fast model: the live "what next?" decision after every answer (must return in under 6s).
# Free-tier rate limits are per model, so splitting the calls doubles the headroom. Each backs the other up.
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# minimal keeps decisions around 1s. gemini-3.8-flash only accepts low or higher.
GEMINI_THINKING_LEVEL=minimal

ELEVENLABS_API_KEY=
# Voice ID from the ElevenLabs Voice Library. cjVigY5qzO86Huf0OWal = "Eric" (premade, conversational).
ELEVENLABS_VOICE_ID=
# Lowest-latency TTS model.
ELEVENLABS_MODEL=eleven_flash_v2_5

PRESAGE_API_KEY=
# Blank = Data runs in memory. Put the real Tiger Data URL here to store sessions.
TIGER_DATABASE_URL=
# Presage readings below this confidence are dropped (0.4 = Presage's accuracy standard for heart rate). Watch /health → sensor.stored
# vs. sensor.below_cutoff during a live capture and lower this if a visible face is being dropped.
DATA_MIN_CONFIDENCE=0.4

# 1 = offline mode: canned questions, rule-based decisions, placeholder audio. No Gemini or ElevenLabs calls.
BRAIN_FAKE=0
# Blank = audio URLs are relative (/audio/x.mp3), which the frontend's dev proxy serves. Only set this
# if the frontend loads audio straight from another origin, e.g. http://localhost:8000.
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
