# Copy to .env (repo root) and fill in. Never commit .env.

GEMINI_API_KEY=
# Fast Flash model. Check AI Studio if this ever 404s.
GEMINI_MODEL=gemini-3.8-flash
# low keeps decide_next under ~2s. Leave blank for the model default.
GEMINI_THINKING_LEVEL=low

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Lowest-latency TTS model.
ELEVENLABS_MODEL=eleven_flash_v2_5

PRESAGE_API_KEY=
TIGER_DATABASE_URL=postgres://...

# 1 = canned questions, rule-based decisions, canned report. No Gemini or ElevenLabs calls.
BRAIN_FAKE=0
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
