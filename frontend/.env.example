# Copy to .env.local (gitignored) and adjust. Restart `npm run dev` after changes.

# 1 = run the whole app against src/mocks/ (scripted interview, fake vitals, sample replay).
# No backend needed. Add ?mock=auto to the session URL to have the mock answer for you.
VITE_MOCK=0

# Leave empty (recommended): the browser calls its own origin and the Vite dev server
# proxies /api, /audio and /ws to VITE_PROXY_TARGET. No CORS, and the voice waveform works.
# Set it to call a backend directly instead (the backend must allow this origin via CORS).
VITE_API_URL=

# Where the dev/preview proxy forwards backend routes (read by vite.config.ts only).
VITE_PROXY_TARGET=http://localhost:8000
