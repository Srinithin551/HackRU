+
+// StressTest bridge: append each metrics update ("Pulse rate: 72.0 bpm (92%)", "Breathing rate: ...",
+// "EDA Proxy level: ...") to the log that StressTest's sensing_client/client.py follows.
+// Path: $SMARTSPECTRA_LOG_FILE, or ~/smartspectra_session.txt.
+std::mutex g_stresstest_log_mutex;
+
+void AppendLinesToStressTestLog(const std::vector<std::string>& lines) {
+    if (lines.empty()) {
+        return;
+    }
+    static const std::string path = [] {
+        const char* override_path = std::getenv("SMARTSPECTRA_LOG_FILE");
+        if (override_path != nullptr && *override_path != '\0') {
+            return std::string(override_path);
+        }
+        return std::string([NSHomeDirectory() UTF8String]) + "/smartspectra_session.txt";
+    }();
+    std::lock_guard<std::mutex> lock(g_stresstest_log_mutex);
+    std::ofstream out(path, std::ios::app);
+    for (const auto& line : lines) {
+        out << line << '\n';
+    }
 }
 
